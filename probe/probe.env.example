# 源站探针运行期配置模板。
# 复制到 /etc/hysteria/probe.env，权限 0600；绝不提交真实值。
#
# HY2_STATS_SECRET 生成方式（在源站本机执行）：
#   python3 -c "import secrets; print(secrets.token_hex(24))"
# 该值必须与 /etc/hysteria/config.yaml 中 trafficStats.secret 完全一致，
# setup_origin.py 会用它幂等写入配置。
HY2_STATS_SECRET=
HY2_STATS_URL=http://127.0.0.1:9999
PROBE_PORT=2096
PROBE_DATA_DIR=/var/lib/hy2dash-probe

# 回源共享令牌：Worker 侧同名 Secret，值必须完全一致。
# 生成：python3 -c "import secrets; print(secrets.token_hex(32))"
# 留空则探针拒绝启动（无弱校验模式）。
PROBE_TOKEN=
