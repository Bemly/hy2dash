# 源站探针运行期配置模板。
# 复制到 /etc/hysteria/probe.env，权限 0600；绝不提交真实值。
#
# HY2_STATS_SECRET 生成方式（在源站本机执行）：
#   python3 -c "import secrets; print(secrets.token_hex(24))"
# 该值必须与 /etc/hysteria/config.yaml 中 trafficStats.secret 完全一致，
# setup_origin.py 会用它幂等写入配置。
HY2_STATS_SECRET=
HY2_STATS_URL=http://127.0.0.1:9999
PROBE_PORT=2096
PROBE_DATA_DIR=/var/lib/hy2dash-probe

# 回源共享令牌：Worker 侧同名 Secret，值必须完全一致。
# 生成：python3 -c "import secrets; print(secrets.token_hex(32))"
# 留空则探针拒绝启动（无弱校验模式）。
PROBE_TOKEN=

# 证书守护（可选）：每 6 小时看一次剩余天数，低于阈值就跑续签命令。
# 默认 30 天 / certbot renew --quiet；用别的 ACME 客户端就改这一行。
# CERT_RENEW_DAYS=30
# CERT_RENEW_CMD="certbot renew --quiet"

# 连接/域名明细（可选）
# VLESS 的明细来自 xray 的 access log，需要在 /usr/local/etc/xray/config.json 里设置
#   "log": { "access": "/var/log/xray/access.log" }
# 探针只读跟随该文件（不写），轮转交给 logrotate。
# VLESS_ACCESS_LOG=/var/log/xray/access.log
# DOMAIN_RETENTION_DAYS=30     # history-*.jsonl 与 domains-*.json 的保留天数
# VLESS_RECENT_SECONDS=600     # 「活动连接」里 VLESS 记录的保留窗口
