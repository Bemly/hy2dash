
# --- 订阅展示头（可选） ---
# 订阅卡片右键「首页」按钮的落地页；留空回退 https://$PANEL_HOST/。
# 面板实际挂在 /ochinchin 子路径，生产请显式配置完整路径。
PROFILE_WEB_PAGE_URL=

# --- Hostker 面板流量（可选，Subscription-Userinfo 数据源） ---
# 面板账号密码（Secret）。两者任一缺失：订阅照常下发，只是不带流量头。
HOSTKER_EMAIL=
HOSTKER_PASSWORD=
# 目标机公网 IP（在 Cloud.getList 结果里全文匹配）。
HOSTKER_SERVER_IP=
# 直接指定实例 uuid 时跳过 getList（可选）。
HOSTKER_UUID=
# 面板返回里探不到配额字段时的兜底月配额（GB，可带小数）。
HOSTKER_TOTAL_GB=
