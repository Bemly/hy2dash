# 复制到 ~/.config/hy2dash/cert.env 后 chmod 600，不要提交到任何仓库。
# 续签脚本事见 scripts/acme-cert.sh。
#
# DNS 由 Hostker 的 PowerDNS 托管，acme.sh 用 dns_pdns 插件写 _acme-challenge TXT 记录。
# PDNS_* 对应 acme.sh dnsapi/dns_pdns.sh 的 PDNS_Url / PDNS_ServerId / PDNS_Token。
ACME_DOMAIN=www.example.com
ACME_EMAIL=you@example.com
PDNS_URL=https://pdns.example.com
PDNS_SERVER_ID=localhost
PDNS_TOKEN=replace-with-api-token

# 以下可选，默认值即生产路径
# CERT_FULLCHAIN=/etc/hysteria/server.crt
# CERT_KEY=/etc/hysteria/server.key
# CERT_RELOAD_CMD=systemctl restart hysteria-server && systemctl restart hy2dash-probe
# PDNS_TTL=60
